# Ninomae theme for btop, generated by matugen from the wallpaper (config/matugen/config.toml). Like the
# VS Code editor theme: lavender (primary) for structure, pink (tertiary) for activity, salmon (error)
# for hot/high. btop reloads it on its own after a wallpaper change (the template's post_hook).

# Background (only used with theme_background = true; btop.conf keeps the terminal's own, translucent one)
theme[main_bg]="{{colors.surface.default.hex}}"

# Text
theme[main_fg]="{{colors.on_surface.default.hex}}"
theme[title]="{{colors.on_surface.default.hex}}"
theme[hi_fg]="{{colors.primary.default.hex}}"
theme[inactive_fg]="{{colors.outline.default.hex}}"
theme[graph_text]="{{colors.on_surface_variant.default.hex}}"
theme[proc_misc]="{{colors.tertiary.default.hex}}"

# Selected process row
theme[selected_bg]="{{colors.secondary_container.default.hex}}"
theme[selected_fg]="{{colors.on_secondary_container.default.hex}}"

# Empty part of meters
theme[meter_bg]="{{colors.surface_container_highest.default.hex}}"

# Box outlines and dividers
theme[cpu_box]="{{colors.primary.default.hex}}"
theme[mem_box]="{{colors.tertiary.default.hex}}"
theme[net_box]="{{colors.secondary.default.hex}}"
theme[proc_box]="{{colors.outline.default.hex}}"
theme[div_line]="{{colors.outline_variant.default.hex}}"

# Gradients: start (low) -> mid -> end (high)
theme[temp_start]="{{colors.primary.default.hex}}"
theme[temp_mid]="{{colors.tertiary.default.hex}}"
theme[temp_end]="{{colors.error.default.hex}}"

theme[cpu_start]="{{colors.primary.default.hex}}"
theme[cpu_mid]="{{colors.tertiary.default.hex}}"
theme[cpu_end]="{{colors.error.default.hex}}"

theme[free_start]="{{colors.primary_container.default.hex}}"
theme[free_mid]="{{colors.primary.default.hex}}"
theme[free_end]="{{colors.primary_fixed.default.hex}}"

theme[cached_start]="{{colors.secondary_container.default.hex}}"
theme[cached_mid]="{{colors.secondary.default.hex}}"
theme[cached_end]="{{colors.secondary_fixed.default.hex}}"

theme[available_start]="{{colors.tertiary_container.default.hex}}"
theme[available_mid]="{{colors.tertiary.default.hex}}"
theme[available_end]="{{colors.tertiary_fixed.default.hex}}"

theme[used_start]="{{colors.tertiary.default.hex}}"
theme[used_mid]="{{colors.error.default.hex}}"
theme[used_end]="{{colors.on_error_container.default.hex}}"

theme[download_start]="{{colors.primary_container.default.hex}}"
theme[download_mid]="{{colors.primary.default.hex}}"
theme[download_end]="{{colors.primary_fixed.default.hex}}"

theme[upload_start]="{{colors.tertiary_container.default.hex}}"
theme[upload_mid]="{{colors.tertiary.default.hex}}"
theme[upload_end]="{{colors.tertiary_fixed.default.hex}}"

theme[process_start]="{{colors.primary.default.hex}}"
theme[process_mid]="{{colors.tertiary.default.hex}}"
theme[process_end]="{{colors.error.default.hex}}"
