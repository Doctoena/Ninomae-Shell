    "input.border": "{{colors.surface_container_high.default.hex}}",
    "input.placeholderForeground": "{{colors.outline.default.hex}}",
    "inputOption.activeBackground": "{{colors.primary.default.hex}}40",
    "inputOption.activeBorder": "{{colors.primary.default.hex}}",
    "dropdown.background": "{{colors.surface_container.default.hex}}",
    "dropdown.border": "{{colors.surface_container_high.default.hex}}",
