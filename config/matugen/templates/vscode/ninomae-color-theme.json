    "terminal.foreground": "{{colors.on_surface.default.hex}}",
    "terminalCursor.foreground": "{{colors.primary.default.hex}}",
    "terminal.selectionBackground": "{{colors.primary.default.hex}}40",
    "terminal.ansiBlack": "{{colors.surface_container_highest.default.hex}}",
    "terminal.ansiBrightBlack": "{{colors.outline.default.hex}}",
    "terminal.ansiRed": "{{colors.error.default.hex}}",
    "terminal.ansiBrightRed": "{{colors.on_error_container.default.hex}}",
    "terminal.ansiGreen": "#a6d7a0",
    "terminal.ansiBrightGreen": "#c3ecbc",
    "terminal.ansiYellow": "#ecd29a",
    "terminal.ansiBrightYellow": "#f8e6bd",
    "terminal.ansiBlue": "{{colors.primary.default.hex}}",
    "terminal.ansiBrightBlue": "{{colors.primary_fixed.default.hex}}",
    "terminal.ansiMagenta": "{{colors.tertiary.default.hex}}",
    "terminal.ansiBrightMagenta": "{{colors.tertiary_fixed.default.hex}}",
    "terminal.ansiCyan": "#9ccfe6",
    "terminal.ansiBrightCyan": "#c5e7f5",
    "terminal.ansiWhite": "{{colors.on_surface_variant.default.hex}}",
    "terminal.ansiBrightWhite": "{{colors.on_surface.default.hex}}"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "{{colors.outline.default.hex}}", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "{{colors.primary.default.hex}}" } },
    { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "{{colors.on_surface_variant.default.hex}}" } },
    { "scope": ["string", "string.quoted", "markup.inline.raw"], "settings": { "foreground": "{{colors.tertiary.default.hex}}" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character", "support.constant"], "settings": { "foreground": "{{colors.tertiary_fixed.default.hex}}" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "{{colors.primary_fixed.default.hex}}" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "{{colors.secondary_fixed.default.hex}}", "fontStyle": "bold" } },
    { "scope": ["variable", "meta.definition.variable"], "settings": { "foreground": "{{colors.on_surface.default.hex}}" } },
    { "scope": ["variable.parameter", "variable.other.property", "entity.other.attribute-name", "support.variable.property"], "settings": { "foreground": "{{colors.on_surface_variant.default.hex}}" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "{{colors.primary.default.hex}}" } },
    { "scope": ["variable.language", "keyword.other.this"], "settings": { "foreground": "{{colors.tertiary.default.hex}}", "fontStyle": "italic" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "{{colors.primary.default.hex}}", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "{{colors.primary.default.hex}}" } },
    { "scope": ["invalid"], "settings": { "foreground": "{{colors.error.default.hex}}" } }
  ]
}
