// By Doctoena

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/ascii.txt",
    "type": "file",
    "padding": {
      "left": 5,
      "top": 2,
      "right": 5
    },
    "color": {
      "1": "white"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "separator": "white"
    }
  },
  "modules": [
    "break",
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────────── Software ──────────────────────┐"
    },
    {
      "type": "os",
      "key": "{#90}│ {#green} OS",
      "format": "{2}"
    },
    {
      "type": "kernel",
      "key": "{#90}│ ├{#green} "
    },
    {
      "type": "packages",
      "key": "{#90}│ ├{#green} "
    },
    {
      "type": "shell",
      "key": "{#90}│ └{#green} "
    },
    {
      "type": "custom",
      "format": "\u001b[90m│"
    },
    {
      "type": "wm",
      "key": "{#90}│ {#blue} WM"
    },
    {
      "type": "theme",
      "key": "{#90}│ ├{#blue} "
    },
    {
      "type": "terminal",
      "key": "{#90}│ └{#blue} "
    },
    {
      "type": "custom",
      "format": "\u001b[90m└──────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────────── Hardware ──────────────────────┐"
    },
    {
      "type": "host",
      "key": "{#90}│ {#magenta} PC",
      "format": "{2}"
    },
    {
      "type": "cpu",
      "key": "{#90}│ ├{#magenta} "
    },
    {
      "type": "gpu",
      "key": "{#90}│ ├{#magenta} ",
      "format": "{2} [{6}]"
    },
    {
      "type": "memory",
      "key": "{#90}│ ├{#magenta} "
    },
    {
      "type": "disk",
      "key": "{#90}│ └{#magenta} "
    },
    {
      "type": "custom",
      "format": "\u001b[90m└──────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌───────────────────── Other Info ─────────────────────┐"
    },
    {
      "type": "command",
      "key": "{#90}│ {#magenta} OS Age",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days"
    },
    {
      "type": "uptime",
      "key": "{#90}│ {#magenta} Uptime"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└──────────────────────────────────────────────────────┘"
    },
    "break"
  ]
}
