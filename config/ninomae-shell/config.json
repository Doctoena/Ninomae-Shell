{
  "appearance": {
    "extraBackgroundTint": true,
    "palette": {
      "type": "scheme-content"
    },
    "themeTransition": true,
    "wallpaperTheming": {
      "enableAppsAndShell": true,
      "enableQtApps": true,
      "enableTerminal": true,
      "terminalGenerationProps": {
        "forceDarkMode": false
      }
    }
  },
  "apps": {
    "bluetooth": "~/.config/hypr/hyprland/scripts/launch_first_available.sh \"blueman-manager\" \"kitty -1 bluetoothctl\"",
    "network": "nm-connection-editor",
    "networkEthernet": "nm-connection-editor",
    "taskManager": "kitty -1 btop",
    "terminal": "kitty -1",
    "volumeMixer": "~/.config/hypr/hyprland/scripts/launch_first_available.sh \"pavucontrol-qt\" \"pavucontrol\""
  },
  "audio": {
    "protection": {
      "enable": false,
      "maxAllowed": 99,
      "maxAllowedIncrease": 10
    }
  },
  "background": {
    "hideWhenFullscreen": true,
    "parallax": {
      "autoVertical": false,
      "enableWorkspace": true,
      "vertical": false,
      "workspaceZoom": 1.07
    },
    "thumbnailPath": "",
    "wallpaperPath": "~/Pictures/Wallpapers/purpgirl.png"
  },
  "bar": {
    "borderless": false,
    "bottom": false,
    "cornerStyle": 1,
    "floatStyleShadow": true,
    "indicators": {
      "battery": {
        "show": true
      },
      "notifications": {
        "showUnreadCount": false
      }
    },
    "resources": {
      "cpuWarningThreshold": 90,
      "memoryWarningThreshold": 95
    },
    "screenList": [],
    "showBackground": true,
    "tray": {
      "filterPassive": true,
      "invertPinnedItems": true,
      "monochromeIcons": true,
      "pinnedItems": [],
      "showItemId": false
    },
    "verbose": true,
    "weather": {
      "city": "",
      "enable": true,
      "enableGPS": false,
      "fetchInterval": 10,
      "useUSCS": false
    },
    "workspaces": {
      "numberMap": [
        "一",
        "二",
        "三",
        "四",
        "五",
        "六",
        "七",
        "八",
        "九",
        "十"
      ],
      "shown": 8,
      "useNerdFont": false
    }
  },
  "battery": {
    "automaticSuspend": true,
    "critical": 5,
    "full": 100,
    "low": 20,
    "suspend": 3
  },
  "conflictKiller": {
    "autoKillNotificationDaemons": false,
    "autoKillTrays": false
  },
  "crosshair": {
    "circle": false,
    "circleOpacity": 100,
    "circleRadius": 10,
    "circleThickness": 1,
    "color": "#3febb9",
    "dot": false,
    "dotOpacity": 100,
    "dotSize": 2,
    "games": [
      "steam_108600"
    ],
    "gap": 1,
    "length": 7,
    "lineOpacity": 100,
    "lines": true,
    "outerGap": 10,
    "outerLength": 2,
    "outerLines": false,
    "outerOpacity": 50,
    "outerThickness": 2,
    "outline": true,
    "outlineOpacity": 100,
    "outlineThickness": 1,
    "thickness": 2,
    "topLine": true,
    "verticalLength": 0
  },
  "dock": {
    "enable": false,
    "height": 60,
    "hoverRegionHeight": 2,
    "hoverToReveal": true,
    "ignoredAppRegexes": [],
    "monochromeIcons": false,
    "pinnedApps": [
      "org.gnome.Nautilus",
      "kitty"
    ],
    "pinnedOnStartup": false
  },
  "gameLauncher": {
    "clipKey": "grave",
    "clipKeyLabel": "`",
    "clipMic": true,
    "clipSeconds": 60,
    "clipsEnabled": true,
    "clipsFolder": "~/Videos/Clips",
    "fallbackToIcons": false,
    "hidePartialBoxArt": true,
    "hideWithoutBoxArt": true,
    "immichEnabled": true,
    "immichUrl": "",
    "launchAnimation": true,
    "newsUpdatesOnly": false,
    "sortOrder": "recency",
    "steamApiKey": "",
    "steamGridDbApiKey": ""
  },
  "hacks": {
    "arbitraryRaceConditionDelay": 20
  },
  "input": {
    "keyboard": {
      "numlockByDefault": true,
      "repeatDelay": 250,
      "repeatRate": 35
    },
    "mouse": {
      "accelProfile": "flat",
      "leftHanded": false,
      "naturalScroll": false,
      "scrollFactor": 1,
      "sensitivity": 0
    },
    "touchpad": {
      "clickfinger": false,
      "disableWhileTyping": true,
      "naturalScroll": false,
      "scrollFactor": 1,
      "tapAndDrag": true,
      "tapToClick": true
    }
  },
  "interactions": {
    "deadPixelWorkaround": {
      "enable": false
    },
    "scrolling": {
      "fasterTouchpadScroll": false,
      "mouseScrollDeltaThreshold": 120,
      "mouseScrollFactor": 120,
      "touchpadScrollFactor": 450
    }
  },
  "language": {
    "ui": "auto"
  },
  "light": {
    "antiFlashbang": {
      "enable": false
    },
    "night": {
      "automatic": false,
      "colorTemperature": 5000,
      "from": "19:00",
      "to": "06:30"
    }
  },
  "lock": {
    "blur": {
      "enable": true,
      "extraZoom": 1.1,
      "radius": 35
    },
    "launchOnStartup": false,
    "materialShapeChars": false,
    "security": {
      "requirePasswordToPower": false,
      "unlockKeyring": true
    }
  },
  "media": {
    "filterDuplicatePlayers": true
  },
  "networking": {
    "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/123.0.0.0 Safari/537.36"
  },
  "notifications": {
    "timeout": 5000
  },
  "osd": {
    "timeout": 1000
  },
  "regionSelector": {
    "circle": {
      "padding": 10,
      "strokeWidth": 6
    },
    "rect": {
      "showAimLines": true
    },
    "save": true,
    "saveDir": "~/Pictures/Screenshots",
    "targetRegions": {
      "content": true,
      "contentRegionOpacity": 0.8,
      "layers": false,
      "opacity": 0.3,
      "showLabel": false,
      "windows": true
    }
  },
  "resources": {
    "updateInterval": 3000
  },
  "search": {
    "engineBaseUrl": "https://www.google.com/search?q=",
    "excludedSites": [
      "quora.com",
      "facebook.com"
    ],
    "imageSearch": {
      "imageSearchEngineBaseUrl": "https://lens.google.com/uploadbyurl?url=",
      "useCircleSelection": false
    },
    "nonAppResultDelay": 30,
    "prefix": {
      "action": "/",
      "app": ">",
      "clipboard": ";",
      "emojis": ":",
      "math": "=",
      "shellCommand": "$",
      "showDefaultActionsWithoutPrefix": false,
      "webSearch": "?"
    },
    "sloppy": false
  },
  "sidebar": {
    "keepRightSidebarLoaded": true,
    "quickSliders": {
      "enable": false,
      "showBrightness": true,
      "showMic": false,
      "showVolume": true
    },
    "quickToggles": {
      "android": {
        "columns": 5,
        "toggles": [
          {
            "size": 2,
            "type": "network"
          },
          {
            "size": 2,
            "type": "bluetooth"
          },
          {
            "size": 1,
            "type": "powerProfile"
          },
          {
            "size": 2,
            "type": "audio"
          },
          {
            "size": 2,
            "type": "mic"
          },
          {
            "size": 1,
            "type": "screenSnip"
          }
        ]
      },
      "style": "android"
    },
    "resourceMonitor": {
      "enable": true
    }
  },
  "sounds": {
    "battery": false,
    "theme": "freedesktop"
  },
  "time": {
    "dateFormat": "ddd, dd/MM",
    "format": "h:mm AP",
    "secondPrecision": false,
    "showAmPm": false
  },
  "windows": {
    "layoutPreset": "auto"
  }
}
